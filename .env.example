# Copy to .env.local and fill in. Real keys are never committed.
# Values live in the Supabase dashboard (project oznqiwldgjrykadqsriv).
NEXT_PUBLIC_SUPABASE_URL=https://oznqiwldgjrykadqsriv.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Email - set ONE transport. Mail is OFF until one is configured.
#
# Option A: free Gmail/Outlook via SMTP app password (no domain needed).
#   Gmail:   SMTP_HOST=smtp.gmail.com          SMTP_PORT=465
#   Outlook: SMTP_HOST=smtp-mail.outlook.com   SMTP_PORT=587
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
#
# Option B: Mailtrap Send API (MAIL_FROM needs a verified domain).
MAILTRAP_TOKEN=
# Optional: route ALL mail into a Mailtrap sandbox inbox while testing.
MAILTRAP_INBOX_ID=
#
# Shared:
MAIL_FROM=Green Bergen <hello@yourdomain.com>
MAIL_ADMIN=shahar.greenberg@gmail.com
