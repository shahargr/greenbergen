# Copy to .env.local and fill in. Real keys are never committed.
# Values live in the Supabase dashboard (project oznqiwldgjrykadqsriv).
NEXT_PUBLIC_SUPABASE_URL=https://oznqiwldgjrykadqsriv.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Email (Mailtrap) - mail is OFF until MAILTRAP_TOKEN is set.
# MAIL_FROM must be a sender on a Mailtrap-verified domain.
MAILTRAP_TOKEN=
MAIL_FROM=Green Bergen <hello@yourdomain.com>
MAIL_ADMIN=shahar.greenberg@gmail.com
# Optional: route ALL mail into a Mailtrap sandbox inbox while testing.
MAILTRAP_INBOX_ID=
